rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'naviora.pvt@gmail.com' &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isProvisionedTeamAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'team_admin') ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.uid == request.auth.uid &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.email == request.auth.token.email &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true &&
           get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'team_admin')
        );
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          isOwner() ||
          isProvisionedTeamAdmin()
        );
    }

    // Public readable site settings, admin editable
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable IT services, admin editable
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable courses catalog, admin editable
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable showcase projects, admin editable
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable learning resources & engineering notes, admin editable
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable team faculty & leads, admin editable
    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact Inquiries: Anyone can submit an inquiry/RFP; strictly private to admins
    match /contactInquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'id', 'name', 'email', 'phone', 'inquiryType', 'subject',
                         'message', 'budget', 'timeline', 'services', 'status', 'createdAt'
                       ]) &&
                       request.resource.data.status == 'New' &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 120 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 0 &&
                       request.resource.data.email.size() <= 150 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }

    // Admin audit logs: admins can read and append; cannot modify/delete history
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() ||
                    (isSignedIn() && (request.auth.uid == adminId || request.auth.token.email == adminId));
      allow create, update: if isOwner() &&
        (adminId == request.resource.data.uid || adminId == request.resource.data.email) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.role == 'team_admin' &&
        request.resource.data.authType == 'password' &&
        request.resource.data.active == true &&
        request.resource.data.uid is string &&
        request.resource.data.createdBy == 'naviora.pvt@gmail.com' &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'authType', 'active',
          'emailVerified', 'createdAt', 'createdBy'
        ]);
      allow delete: if isOwner();
    }
  }
}
